# FaucetPay Recovery Core
# Copy this file to .env only when environment variables
# are actually needed.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_PATH=./data/recovery.db

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# Discovery
DISCOVERY_ENABLED=true
DISCOVERY_URL=https://faucetpay.io/faucets
DISCOVERY_REFRESH_SECONDS=3600
DISCOVERY_MAX_PAGES=25

# Scoring
SCORING_COOLDOWN_WEIGHT=0.15
SCORING_SUCCESS_WEIGHT=0.25
SCORING_MINIMUM_SCORE=0.0

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_MAX_TASKS_PER_CYCLE=50

# Future account integration.
# Keep credentials OUT of Git.
# FAUCETPAY_EMAIL=
# FAUCETPAY_PASSWORD=
